<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Zerochan" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/zerochan_background</item>
    </style>

    <style name="Theme.Zerochan.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/zerochan_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Zerochan</item>
    </style>
</resources>